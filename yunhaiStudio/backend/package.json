{
  "name": "@yunhai/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "云海科技 YunHai 后端，由 open-ai-canvas Go 后端逐文件迁移为 TypeScript",
  "main": "src/cmd/server/main.ts",
  "scripts": {
    "dev": "tsx watch src/cmd/server/main.ts",
    "start": "tsx src/cmd/server/main.ts",
    "typecheck": "tsc --noEmit",
    "build": "esbuild src/cmd/server/main.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/server.mjs"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^13.0.3",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.1",
    "uuid": "^11.1.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^9.6.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "@types/ws": "^8.5.13",
    "esbuild": "^0.24.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
